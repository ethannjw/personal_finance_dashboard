# Copy to .env and fill in your own values. Never commit .env or OAuth tokens.
# Workbook ID only, not the complete Google Sheets URL.
FINANCE_SHEET_ID=
# Authorized-user OAuth JSON (outside this repository is recommended).
# ~/ is supported; relative paths resolve from the .env directory.
GOOGLE_TOKEN_FILE=~/.config/ledger/google_token.json
FINANCE_TRANSACTIONS_TAB="📋 Transactions"
FINANCE_CATEGORIES_TAB="🏷️ Categories"
FINANCE_HOST=127.0.0.1
FINANCE_PORT=8765
